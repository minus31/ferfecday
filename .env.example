# Browser, included in the static build. Never put a service_role or OpenAI key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SERVICE_API_URL=https://ferfecday.vercel.app/api/service
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_PRIVACY_OFFICER=
NEXT_PUBLIC_SUPABASE_COUNTRY=
NEXT_PUBLIC_BUSINESS_NUMBER=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_COMMERCE_NUMBER=

# Server only, configure in Vercel. Keep actual secrets in .env.local, never commit.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_SAJU_MODEL=gpt-5.5
OPENAI_IMAGE_MODEL=gpt-image-1
ALLOWED_ORIGINS=https://ferfecday.vercel.app,https://birthdaygift.web.tossmini.com,https://birthdaygift.private-web.tossmini.com

# Deliberately opt-in. Public demo credentials route to this strong private password.
TEST_ACCOUNT_ENABLED=false
TEST_ACCOUNT_PASSWORD=

# Do not enable public launch until privacy recipients/regions/retention are finalized.
PRIVACY_REVIEW_COMPLETE=false
